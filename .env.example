# 현재 compose.yaml은 PROD_* 값을 사용합니다.
PROD_POSTGRES_HOST=
PROD_POSTGRES_USER=
PROD_POSTGRES_PASSWORD=
PROD_POSTGRES_DB=
PROD_POSTGRES_PORT=
PROD_BACKEND_HOST=
PROD_BACKEND_PORT=

# 개발 환경에서 직접 실행할 때 사용할 값입니다.
DEV_POSTGRES_USER=
DEV_POSTGRES_PASSWORD=
DEV_POSTGRES_DB=
DEV_POSTGRES_PORT=
DEV_BACKEND_HOST=
DEV_BACKEND_PORT=

# secret의 실제 값은 Git에서 무시되는 .env 파일에만 보관합니다.
RUNTIME_TOKEN_SECRET=
X402_PRIVATE_KEY=
